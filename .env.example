AZURE_STORAGE_ACCOUNT_URL=https://<your-storage-account>.blob.core.windows.net
AZURE_STORAGE_CONTAINER=<your-private-container>

# Optional: strict app allow-list (comma-separated)
ALLOWED_USER_EMAILS=

# Optional: admin users (comma-separated)
ADMIN_USER_EMAILS=

# Optional: shared folder (default: shared)
SHARED_FOLDER_NAME=shared

# Optional for local development only
LOCAL_DEV_USER_EMAIL=

# Optional upload cap per file in MB (0 = no app limit)
MAX_UPLOAD_MB=2048

# Optional chunk size for browser chunked upload (MB)
UPLOAD_CHUNK_MB=8
